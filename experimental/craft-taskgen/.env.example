# Required for Harbor agent smoke tests
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://inference-api.nvidia.com/v1

# Anthropic-compatible aliases for Harbor smoke test (claude_code.py reads these)
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_BASE_URL=https://inference-api.nvidia.com

# Optional: separate key for LLM-judge steps
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=aws/anthropic/bedrock-claude-sonnet-4-6

